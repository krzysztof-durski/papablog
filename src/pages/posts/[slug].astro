---
export const prerender = false;

import { env } from 'cloudflare:workers';
import { marked } from 'marked';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPostBySlug } from '../../lib/db/posts';

const { slug } = Astro.params;
if (!slug) return new Response('Not found', { status: 404 });

const post = await getPublishedPostBySlug(env.DB, slug);
if (!post) return new Response('Not found', { status: 404 });

// Same trust model as the admin editor's own live preview
// (src/components/admin/MarkdownPreview.tsx) — this content only ever
// comes from the site's own writer, so there's no sanitization boundary
// being crossed by rendering it as raw HTML.
const bodyHtml = marked.parse(post.bodyMarkdown, { async: false });
---

<PostLayout post={post}>
  <Fragment set:html={bodyHtml} />
</PostLayout>
