---
export const prerender = false;

import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAccessEmail } from '../../lib/auth/context';
import { listDrafts } from '../../lib/db/drafts';

const email = getAccessEmail(Astro.locals);
const drafts = await listDrafts(env.DB, 'draft');
const published = await listDrafts(env.DB, 'published');
const archived = await listDrafts(env.DB, 'archived');

function formatDate(iso: string): string {
  return new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
}
---

<AdminLayout title="Admin">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="font-brand text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Admin</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-500">
        Logged in as <strong>{email}</strong>
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin/trash" class="text-sm text-slate-500 hover:text-slate-900 hover:underline dark:hover:text-white">
        Trash
      </a>
      <a
        href="/admin/posts/new"
        class="rounded-md border border-slate-900 px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-slate-900 hover:text-white dark:border-white dark:text-white dark:hover:bg-white dark:hover:text-slate-900"
      >
        New post
      </a>
    </div>
  </div>

  <section class="mb-10">
    <h2 class="font-brand mb-3 text-xl font-bold tracking-tight text-slate-900 dark:text-white">Drafts</h2>
    {drafts.length === 0 ? (
      <p class="text-sm text-slate-500 dark:text-slate-500">No drafts yet.</p>
    ) : (
      <ul class="divide-y divide-slate-200 dark:divide-slate-800">
        {drafts.map((draft) => (
          <li class="flex items-center justify-between gap-4 py-3">
            <div>
              <a href={`/admin/posts/${draft.id}/edit`} class="font-semibold hover:underline">
                {draft.title || 'Untitled draft'}
              </a>
              <p class="text-xs text-slate-500 dark:text-slate-500">Updated {formatDate(draft.updatedAt)}</p>
            </div>
            <button
              type="button"
              data-trash-draft={draft.id}
              class="shrink-0 text-xs font-semibold text-red-600 hover:underline dark:text-red-400"
            >
              Delete
            </button>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="mb-10">
    <h2 class="font-brand mb-3 text-xl font-bold tracking-tight text-slate-900 dark:text-white">Published</h2>
    {published.length === 0 ? (
      <p class="text-sm text-slate-500 dark:text-slate-500">Nothing published yet.</p>
    ) : (
      <ul class="divide-y divide-slate-200 dark:divide-slate-800">
        {published.map((post) => (
          <li class="flex items-center justify-between gap-4 py-3">
            <div>
              <a href={`/admin/posts/${post.id}/edit`} class="font-semibold hover:underline">
                {post.title || 'Untitled draft'}
              </a>
              <p class="text-xs text-slate-500 dark:text-slate-500">
                Published {post.publishedAt && formatDate(post.publishedAt)}
              </p>
            </div>
            <div class="flex shrink-0 items-center gap-3 text-xs font-semibold">
              <a
                href={`/admin/posts/${post.id}/edit`}
                class="rounded-md border border-slate-300 px-3 py-1.5 text-slate-700 hover:border-slate-900 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-white dark:hover:text-white"
              >
                Edit
              </a>
              {post.slug && (
                <a
                  href={`/posts/${post.slug}/`}
                  target="_blank"
                  rel="noreferrer"
                  class="text-slate-500 hover:underline dark:text-slate-400"
                >
                  View live ↗
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section>
    <h2 class="font-brand mb-3 text-xl font-bold tracking-tight text-slate-900 dark:text-white">Archived</h2>
    <p class="mb-3 text-sm text-slate-500 dark:text-slate-500">
      Unpublished — no longer live, but not deleted. Edit and republish to bring one back.
    </p>
    {archived.length === 0 ? (
      <p class="text-sm text-slate-500 dark:text-slate-500">Nothing archived.</p>
    ) : (
      <ul class="divide-y divide-slate-200 dark:divide-slate-800">
        {archived.map((post) => (
          <li class="flex items-center justify-between gap-4 py-3">
            <div>
              <a href={`/admin/posts/${post.id}/edit`} class="font-semibold hover:underline">
                {post.title || 'Untitled draft'}
              </a>
              <p class="text-xs text-slate-500 dark:text-slate-500">Updated {formatDate(post.updatedAt)}</p>
            </div>
            <a
              href={`/admin/posts/${post.id}/edit`}
              class="shrink-0 rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-slate-900 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-white dark:hover:text-white"
            >
              Edit
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-trash-draft]').forEach((button) => {
    button.addEventListener('click', () => {
      void (async () => {
        const id = button.dataset.trashDraft;
        if (!id || !confirm('Move this draft to trash?')) return;

        const res = await fetch(`/api/admin/drafts/${id}`, { method: 'DELETE' });
        if (!res.ok) {
          alert('Failed to trash this draft.');
          return;
        }
        button.closest('li')?.remove();
      })();
    });
  });
</script>
