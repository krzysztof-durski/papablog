---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/site/PostCard.astro';
import { listPublishedPosts } from '../../lib/db/posts';

const { tag } = Astro.params;
if (!tag) return new Response('Not found', { status: 404 });

const allPosts = await listPublishedPosts(env.DB);
const posts = allPosts.filter((post) => post.tags.includes(tag));
---

<BaseLayout
  title={tag}
  description={`Posts tagged "${tag}" on PapaBlog.`}
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Tags', href: '/tags' }, { label: tag }]}
>
  <h1 class="font-brand mb-6 border-b border-slate-200 pb-4 text-3xl font-bold tracking-tight text-slate-900 dark:border-slate-800 dark:text-white">
    {tag}
  </h1>
  {posts.length === 0 ? (
    <p class="text-slate-600 dark:text-slate-400">No posts tagged "{tag}" yet.</p>
  ) : (
    <div class="divide-y divide-slate-200 dark:divide-slate-800">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  )}
</BaseLayout>
