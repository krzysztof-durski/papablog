---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description="PapaBlog admin." wide breadcrumbs={breadcrumbs}>
  <slot />
</BaseLayout>
