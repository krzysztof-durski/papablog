---
interface Crumb {
  label: string;
  /** Omit for the current page — the last crumb is always plain text, never a link. */
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500 dark:text-slate-500">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, index) => (
      <li class="flex items-center gap-1.5">
        {index > 0 && (
          <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">
            /
          </span>
        )}
        {item.href ? (
          <a href={item.href} class="hover:text-slate-900 hover:underline dark:hover:text-white">
            {item.label}
          </a>
        ) : (
          <span aria-current="page" class="text-slate-700 dark:text-slate-300">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
