---
import type { PublishedPost } from '../../lib/db/posts';
import TagBadge from './TagBadge.astro';

interface Props {
  post: PublishedPost;
}

const { post } = Astro.props;
const publishDate = new Date(post.publishedAt);
const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="py-7 first:pt-0">
  <a href={`/posts/${post.slug}/`} class="group block">
    <h2 class="font-brand text-2xl font-bold tracking-tight text-slate-900 group-hover:underline dark:text-white">
      {post.title}
    </h2>
    <p class="mt-2 text-slate-600 dark:text-slate-400">{post.description}</p>
  </a>
  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs tracking-wide text-slate-500 uppercase dark:text-slate-500">
    <time datetime={publishDate.toISOString()}>{formattedDate}</time>
    {post.tags.length > 0 && (
      <>
        <span aria-hidden="true">&middot;</span>
        <div class="flex flex-wrap gap-x-3">
          {post.tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      </>
    )}
  </div>
</article>
