---
const year = new Date().getFullYear();
---

<footer class="border-t-4 border-slate-900 dark:border-white">
  <div class="mx-auto flex max-w-3xl flex-col gap-4 px-4 py-8 text-xs tracking-wide text-slate-500 uppercase sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8 dark:text-slate-500">
    <p class="normal-case">
      &copy; {year} PapaBlog. Text licensed{' '}
      <a href="/legal/terms" class="underline hover:text-slate-900 dark:hover:text-white">
        CC BY 4.0
      </a>
      , code MIT.
    </p>
    <nav class="flex gap-4" aria-label="Footer">
      <a href="/about" class="hover:text-slate-900 dark:hover:text-white">
        About
      </a>
      <a href="/legal/privacy" class="hover:text-slate-900 dark:hover:text-white">
        Privacy Policy
      </a>
      <a href="/legal/terms" class="hover:text-slate-900 dark:hover:text-white">
        Terms of Service
      </a>
      <a href="/rss.xml" class="hover:text-slate-900 dark:hover:text-white">
        RSS
      </a>
    </nav>
  </div>
</footer>
